# =====================================================================
# VARIABLES DE ENTORNO - FRONTEND MOBILE (EXPO / REACT NATIVE)
# =====================================================================
# En Expo SDK 49+, cualquier variable accesible desde el código de la app
# DEBE comenzar con el prefijo "EXPO_PUBLIC_".
#
# Elige una de las siguientes opciones según tu entorno de ejecución:
# ---------------------------------------------------------------------

# OPCIÓN 1: Emulador de Android oficial (Android Studio / AVD)
# 10.0.2.2 es la dirección IP puente que mapea al localhost de tu PC
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# OPCIÓN 2: Celular físico conectado por Wi-Fi (misma red local que la PC)
# Reemplaza con la IP IPv4 de tu computadora (ej: ipconfig en Windows)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api/v1

# OPCIÓN 3: Servidor en Producción (Máquina Virtual Azure / VPS / Dominio)
# EXPO_PUBLIC_API_URL=http://TU_IP_PUBLICA_AZURE/api/v1
# EXPO_PUBLIC_API_URL=https://api.tudominio.com/api/v1
