# =====================================================================
# SKYLEARN — Variables de Entorno de Producción (Docker Stack)
# =====================================================================
# Copia este archivo como .env en el servidor:
#   cp .env.prod.example .env

# --- 1. Base de Datos PostgreSQL (Contenedor Docker interno) ---
DB_USER=skylearn_admin
DB_PASSWORD=Skylearn2026_ProdPasswordSecure!
DB_NAME=skylearn_db

# --- 2. Seguridad y Autenticación JWT (Backend NestJS) ---
JWT_SECRET=super_secret_jwt_key_skylearn_production_2026_univalle
JWT_EXPIRES_IN=24h

# --- 3. Inteligencia Artificial (Google Gemini) ---
# Obtén tu API Key gratuita en https://aistudio.google.com
GEMINI_API_KEY=AIzaSyTuClaveRealDeGeminiAqui
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# --- 4. Pasarela de Pagos (Stripe) ---
# Claves de prueba o producción de Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_clave_webhook_stripe

# --- 5. Inicialización de Datos Demo ---
# true: Aplica migraciones y además siembra usuarios demo (student@test.com / teacher@test.com)
# false: Solo crea las tablas vacías
RUN_SEED=true

