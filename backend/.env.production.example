# ==========================================
# SKYLEARN BACKEND - PRODUCCIÓN AZURE
# ==========================================

# Puerto asignado por Azure App Service (por defecto 3000 o proporcionado por la plataforma)
PORT=3000

# Conexión a Azure Database for PostgreSQL Flexible Server
# Formato: postgresql://<ADMIN_USER>:<PASSWORD>@<SERVIDOR_AZURE>.postgres.database.azure.com:5432/<DB_NAME>?schema=public&sslmode=require
DATABASE_URL="postgresql://<TU_AZURE_DB_USER>:<TU_AZURE_DB_PASSWORD>@<TU_AZURE_PG_SERVER>.postgres.database.azure.com:5432/skylearn_db?schema=public&sslmode=require"

# Secreto JWT para emisión de tokens de autenticación (Min. 32 caracteres criptográficamente aleatorios)
# Generar con: openssl rand -base64 32
JWT_SECRET="<TU_JWT_SECRET_SEGURO_GENERADO>"
JWT_EXPIRES_IN="24h"

# Google Gemini API Key (Obtenida desde Google AI Studio)
GEMINI_API_KEY="<TU_GEMINI_API_KEY>"
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"

# Stripe Pasarela de Pagos (Modo Producción o Test de Stripe Dashboard)
STRIPE_SECRET_KEY="<TU_STRIPE_SECRET_KEY>"
STRIPE_WEBHOOK_SECRET="<TU_STRIPE_WEBHOOK_SECRET>"

# URLs de Retorno de Checkout Stripe (Apuntando a la URL de Azure Static Web Apps)
STRIPE_SUCCESS_URL="https://<TU_APP_WEB>.azurestaticapps.net/payment/success"
STRIPE_CANCEL_URL="https://<TU_APP_WEB>.azurestaticapps.net/payment/cancel"
